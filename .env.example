# App Settings
APP_NAME="Backend API"
DEBUG=False

# Security
# Generate a real one using: openssl rand -hex 32
SECRET_KEY="supersecretkey123"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Railway will provide this automatically if you attach a Postgres service
# Example: postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./diabetes.db"

# CORS
# For production, set this to your frontend URL: ["https://yourfrontend.up.railway.app"]
ALLOWED_ORIGINS=["*"]
